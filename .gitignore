# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/login.exe
/credit.exe
/wb2api.exe
/signin_bin.exe

# Config with secrets (use config.example.json)
# ⚠️ 必须锚定到仓库根：裸 `config.json` 会连带忽略 .github/actions/ai-governance/config.json
# —— 那是治理 Action **运行时必读**的配置（读不到直接 throw），2026-10-14 就是被这条
#    吃掉导致仓库缺文件。锚定后只忽略根目录的真实网关配置。
/config.json

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
wb2api.pid
*.log
draft_*_folder/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档：只挡**仓库根**的散落 .md（README.md 必须进版本库）。
# ⚠️ 不要写成裸 `*.md`：它会把构建资源一起挡掉 —— internal/prompt/defaultprompt.md
# 是 `//go:embed` 的必需文件，被忽略后 clone 下来直接编译失败（2026-10-14 实测）。
# 子目录里的 .md 一律放行；文档目录已由上面的 docs/ 单独排除。
/*.md
!README.md
# 仍显式放行被 `/*.md` 之外规则波及的构建资源（双保险）
!internal/prompt/defaultprompt.md

# Node 工具链（v0.24.0）：前端回归脚本已移入仓库（tools/），依赖不进版本库。
node_modules/
release/
coverage.out

# 运行期密钥（程序首次启动生成，绝不外发）
admin.key
gateway.key

# ============================================================
# 上传/外发排除（v0.26.0 逐项审计后新增 —— 每一条都有具体理由）
# ============================================================

# 交付目录：含 webapp.exe / 历史 .bak（单个 14MB，实测累计 400MB+）、
# cloudflared.exe(53MB)、SQLite 库、管理密钥、隧道地址日志。
# 它随分发包走，但**源码仓不需要**，且里面有密钥。
/dist/

# 运维草稿（v0.25.x 排查出口线路时留下的）：
#   · tools/usque/config*.json  含 WARP private_key / access_token（凭据！）
#   · tools/warp/eg.py          硬编码本机绝对路径 + 直读 admin.key
#   · *.log / scan.json        扫描残留与运行日志
/tools/warp/
/tools/usque/
/tools/scdn.html
/tools/scdn.json

# 项目内部工作记忆：含部署拓扑、真机 IP、密钥线索、事故复盘。
# 这是给人看的内部笔记，**不是**项目文档，绝不能随仓库外发。
/.workbuddy/

# 临时草稿目录
/.tmp/

# 历史遗留的顶层二进制（9MB，源码已迁到 tools/proxyscan/）
/proxyscan.exe

# 设备风控凭证落盘文件（若按文档方式写到仓库内）
device_token

# 任何位置的可执行产物都不进版本库 —— 本仓是 Go 源码仓，不需要任何二进制。
# 这一条是**兜底**：v0.26.0 首次提交时正是漏了顶层的 webapp.exe（19.7MB）
# 才被 git show --stat 抓出来。黑名单式的逐条列举必然会漏，所以补一条通配。
*.exe
*.dll
*.so
*.dylib
